{
  "name": "orby-user-registration",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "observability": { "enabled": false },
  "d1_databases": [{ "binding": "DB", "database_name": "orby-users", "database_id": "REPLACE_AFTER_PROVISIONING", "migrations_dir": "migrations" }],
  "ratelimits": [{ "name": "REGISTRATION_LIMIT", "namespace_id": "7310313001", "simple": { "limit": 5, "period": 60 } }]
}
