<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>OrbyLauncher</AssemblyName>
    <AssemblyTitle>Orby Launcher</AssemblyTitle>
    <RootNamespace>OrbyLauncher</RootNamespace>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/OrbyLauncher.ico</ApplicationIcon>
    <Version>0.24.0-beta</Version>
    <Company>Think</Company>
    <Authors>Think</Authors>
    <Product>Orby Launcher</Product>
    <Description>Barra de aplicativos, barra de status e central de controle para Windows.</Description>
    <Copyright>© 2026 Think. Créditos do projeto: valteromega2019-blip.</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <Content Include="UpdateInstaller.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets/OrbyLauncher.ico" />
    <Resource Include="Assets/OrbyLauncher.png" />
    <Content Include="../../COPYRIGHT.md" Link="COPYRIGHT.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../SECURITY.md" Link="SECURITY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../../licenses/*" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
