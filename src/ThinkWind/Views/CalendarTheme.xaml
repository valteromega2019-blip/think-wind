<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework">
 <Style x:Key="Think.CalendarDay" TargetType="p:CalendarDayButton">
  <Setter Property="Foreground" Value="{DynamicResource Think.Text}"/><Setter Property="Margin" Value="2"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarDayButton">
   <Border x:Name="Day" Background="Transparent" CornerRadius="7" BorderThickness="1" BorderBrush="Transparent" Padding="5">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource Think.Hover}"/></Trigger>
    <Trigger Property="IsToday" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource Think.Accent}"/></Trigger>
    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Day" Property="Background" Value="{DynamicResource Think.AccentSurface}"/><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource Think.Accent}"/></Trigger>
    <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger>
    <Trigger Property="IsBlackedOut" Value="True"><Setter Property="Opacity" Value="0.25"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Day" Property="BorderBrush" Value="{DynamicResource Think.Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Think.CalendarPeriod" TargetType="p:CalendarButton">
  <Setter Property="Foreground" Value="{DynamicResource Think.Text}"/><Setter Property="Margin" Value="3"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarButton">
   <Border x:Name="Period" Background="Transparent" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Padding="8">
    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Period" Property="Background" Value="{DynamicResource Think.Hover}"/></Trigger>
    <Trigger Property="HasSelectedDays" Value="True"><Setter TargetName="Period" Property="BorderBrush" Value="{DynamicResource Think.Accent}"/></Trigger>
    <Trigger Property="IsInactive" Value="True"><Setter Property="Opacity" Value="0.4"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Period" Property="BorderBrush" Value="{DynamicResource Think.Accent}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Think.CalendarItem" TargetType="p:CalendarItem">
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="p:CalendarItem">
   <ControlTemplate.Resources>
    <DataTemplate x:Key="{x:Static p:CalendarItem.DayTitleTemplateResourceKey}"><TextBlock Text="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Think.Muted}"/></DataTemplate>
   </ControlTemplate.Resources>
   <Grid x:Name="PART_Root">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8">
     <Button x:Name="PART_PreviousButton" Content="‹" Width="34" Height="34" Padding="0" DockPanel.Dock="Left" ToolTip="Período anterior"/>
     <Button x:Name="PART_NextButton" Content="›" Width="34" Height="34" Padding="0" DockPanel.Dock="Right" ToolTip="Próximo período"/>
     <Button x:Name="PART_HeaderButton" Padding="8,5" HorizontalAlignment="Center"/>
    </DockPanel>
    <Grid x:Name="PART_MonthView" Grid.Row="1" Width="280" Height="224">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    </Grid>
    <Grid x:Name="PART_YearView" Grid.Row="1" Width="280" Height="224" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
    </Grid>
   </Grid>
   <ControlTemplate.Triggers>
    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Year"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource AncestorType={x:Type Calendar}}}" Value="Decade"><Setter TargetName="PART_MonthView" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/></DataTrigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style x:Key="Think.Calendar" TargetType="Calendar">
  <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Foreground" Value="{DynamicResource Think.Text}"/>
  <Setter Property="CalendarItemStyle" Value="{StaticResource Think.CalendarItem}"/>
  <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Think.CalendarDay}"/>
  <Setter Property="CalendarButtonStyle" Value="{StaticResource Think.CalendarPeriod}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Calendar">
   <StackPanel x:Name="PART_Root"><p:CalendarItem x:Name="PART_CalendarItem" Style="{TemplateBinding CalendarItemStyle}"/></StackPanel>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
