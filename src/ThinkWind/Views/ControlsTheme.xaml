<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style x:Key="Think.SliderPart" TargetType="RepeatButton">
  <Setter Property="Focusable" Value="False"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
   <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="Slider">
  <Setter Property="Height" Value="28"/><Setter Property="MinWidth" Value="40"/>
  <Setter Property="Foreground" Value="{DynamicResource Think.Accent}"/>
  <Setter Property="Background" Value="{DynamicResource Think.Control}"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid x:Name="Surface" Background="Transparent" SnapsToDevicePixels="True">
    <Border Height="16" Background="{TemplateBinding Background}" CornerRadius="8"/>
    <Track x:Name="PART_Track" Height="24" VerticalAlignment="Center"
           Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
           IsDirectionReversed="{TemplateBinding IsDirectionReversed}" Orientation="{TemplateBinding Orientation}">
     <Track.DecreaseRepeatButton><RepeatButton Height="16" Command="Slider.DecreaseLarge" Background="{TemplateBinding Foreground}" Style="{StaticResource Think.SliderPart}"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb Width="10" Height="24">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="Handle" Background="{DynamicResource Think.Text}" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Think.Control}"/>
       <ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Background" Value="{DynamicResource Think.Accent}"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Thumb.Template>
     </Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Height="16" Command="Slider.IncreaseLarge" Background="{TemplateBinding Background}" Style="{StaticResource Think.SliderPart}"/></Track.IncreaseRepeatButton>
    </Track>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="{DynamicResource Think.Hover}"/></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
</ResourceDictionary>
